---
import "../styles/global.css";
import { languages, t, type Lang } from "../i18n/ui";
import { home } from "../i18n/home";
import Footer from "../components/Footer.astro";
import BtnMark from "../components/BtnMark.astro";
// The sans's regular weight, the first text painted; the same file global.css's @font-face points at.
import sansRegular from "@fontsource/albert-sans/files/albert-sans-latin-400-normal.woff2?url";
// The header's scrollspy and hide-on-scroll, as its own file: inlined, it would take the page's inline
// script past Vite's 4,096 B threshold.
import headerScript from "../scripts/header.js?url&no-inline";

interface Props {
  lang: Lang;
  /** Path after each language prefix, e.g. { es: "casos/automatizacion/", en: "cases/automation/" };
   *  the home page by default. The ES | EN switch, canonical and hreflang follow it. */
  paths?: Record<Lang, string>;
  /** The page's own title and description; the site's by default. */
  title?: string;
  description?: string;
}

const { lang, paths = { es: "", en: "" }, title = t(lang, "site.title"), description = t(lang, "site.description") } = Astro.props;
const href = (l: Lang) => `/${l}/${paths[l]}`;
const isHome = !paths[lang];
// The home's section anchors: from another page they lead back to the home, except the page's own
// contact call and the top of the page.
const at = (anchor: string) => (isHome || !anchor.startsWith("#") || anchor === "#top" || anchor === "#contact" ? anchor : `/${lang}/${anchor}`);
const copy = home[lang];
const footer = {
  ...copy.footer,
  columns: copy.footer.columns.map((column) => ({ ...column, links: column.links.map((link) => ({ ...link, href: at(link.href) })) })),
};
// Caps the display size so the longer hero line always fits the text column (the viewport less both
// insets and the 12 px a cable station may push the heading in). The serif averages ~0.48em per
// character in Georgia (measured on the hero lines); 0.5 leaves room for wider fallback serifs.
const fit = `calc((100vw - 2 * var(--inset) - 12px) / ${(Math.max(copy.hero.line1.length, copy.hero.line2.length) * 0.5).toFixed(2)})`;
---

<!doctype html>
<html lang={lang} style={`--fit:${fit}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="preload" href={sansRegular} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(href(lang), Astro.site)} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(href(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(href("es"), Astro.site)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#content">{copy.skip}</a>
    <!-- Three glass pills floating on a transparent sticky bar, the page showing between them: the name,
         the section links with ES · EN, and the action. src/scripts/header.ts lights the section in view
         and slides the bar away while reading down; without it the bar stays, with no chip. -->
    <header class="site" id="top" data-header>
      <div class="top wrap">
        <!-- The full name on one line; where it would not fit the serif monogram stands in for it on
             screen, and the name stays the link's accessible name. -->
        <a class="wordmark" href={`/${lang}/`}><span class="wordmark__full">Lautaro Guebel</span><span class="wordmark__mono" aria-hidden="true">LG</span></a>
        <div class="top__nav">
          <nav aria-label={copy.nav.label}>
            <span class="nav__chip" data-chip aria-hidden="true"></span>
            <ul>
              <li><a href={at("#automation")}>{copy.nav.cases}</a></li>
              <li><a href={at("#method")}>{copy.nav.method}</a></li>
              <li><a href={at("#offer")}>{copy.nav.offer}</a></li>
              <li><a href={at("#contact")}>{copy.nav.contact}</a></li>
            </ul>
          </nav>
          <div class="langs" role="group" aria-label={copy.nav.language}>
            {
              (Object.keys(languages) as Lang[]).map((l) =>
                l === lang ? (
                  <a href={href(l)} aria-current="page">{l.toUpperCase()}</a>
                ) : (
                  <a href={href(l)} hreflang={l} lang={l}>
                    <span aria-hidden="true">{l.toUpperCase()}</span>
                    <span class="sr-only">{t(lang, "nav.switch")}</span>
                  </a>
                ),
              )
            }
          </div>
        </div>
        <a class="btn top__cta" href="#contact">{copy.nav.cta}<BtnMark kind="arrow" /></a>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <Footer copy={footer} />
    <script>
      import "../scripts/motion";
    </script>
    <script is:inline type="module" src={headerScript}></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 20;
    background: var(--ink);
    color: var(--plate);
    padding: 12px 16px;
  }
  .skip:focus {
    left: var(--inset);
  }

  /* The bar is transparent and sticky: the page shows between the pills, and only the pills take clicks.
     Reading down it slides up past its own height and 16 px more (src/scripts/header.js). */
  .site {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    pointer-events: none;
    view-transition-name: site-header;
    transition: transform 360ms var(--ease-out);
  }
  .site[data-hidden] {
    transform: translateY(calc(-100% - 16px));
  }
  .top {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 60px;
  }
  /* Two pills of brushed metal, 44 px tall (chosen in the impeccable live canvas, L108): a near-opaque
     tone fill, fine horizontal brush lines, a diagonal sheen and a top-light / bottom-ink rim; no drop
     shadow (T23). Ink stays well above AA on the 0.92 tone fill whatever sits behind. */
  .wordmark,
  .top__nav {
    --metal-rim: inset 0 1px 0 rgb(255 255 255 / 0.9), inset 0 -1px 0 rgb(31 42 34 / 0.14),
      0 0 0 1px rgb(31 42 34 / 0.12);
    min-height: 44px;
    border-radius: var(--radius-pill);
    background-color: rgb(234 229 216 / 0.92);
    background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.16) 0 1px, transparent 1px 3px),
      linear-gradient(100deg, rgb(255 255 255 / 0) 20%, rgb(255 255 255 / 0.55) 42%, rgb(255 255 255 / 0) 64%),
      linear-gradient(180deg, rgb(255 255 255 / 0.45), rgb(221 214 196 / 0.4));
    backdrop-filter: blur(10px);
    pointer-events: auto;
  }
  .top__nav {
    box-shadow: var(--metal-rim);
  }
  @media (prefers-reduced-transparency: reduce) {
    .wordmark,
    .top__nav {
      background-color: var(--tone);
      backdrop-filter: none;
    }
  }
  /* The wordmark is a link, so its rim is a layer of its own: a shadow on the link itself, even inset
     light, reads as a button effect to the taste inspector (T23). */
  .wordmark::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: var(--metal-rim);
    pointer-events: none;
  }
  /* Safari before 18, in its own @supports (see .glass in global.css). */
  @supports (-webkit-backdrop-filter: none) {
    .wordmark,
    .top__nav {
      -webkit-backdrop-filter: blur(10px);
    }
  }
  /* The name on one line, in the serif at the subhead size; a step down below the desktop. Never cut: it
     keeps its width, and where it would not fit the monogram stands in (below). */
  .wordmark {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    white-space: nowrap;
    font: 400 var(--fs-sub) / 1 var(--serif);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .wordmark__mono {
    display: none;
  }
  /* The links and ES · EN share one pill, the links first. */
  .top__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-inline: 4px;
  }
  nav {
    position: relative;
  }
  nav ul {
    display: flex;
  }
  nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    font: 400 var(--fs-small) / 1.3 var(--sans);
    text-decoration: none;
    outline-offset: -3px;
    transition: background-color var(--t-hover) ease;
  }
  /* The section being read sits on a lighter chip: placed and shown by the script, it slides from link to
     link. Under the links (they come later and are positioned), inset 4 px inside the pill. */
  .nav__chip {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 420ms var(--ease-out),
      width 420ms var(--ease-out),
      opacity var(--t-hover) ease;
  }
  .nav__chip[data-on] {
    opacity: 1;
  }
  /* ES · EN: two words in the sans with a drawn ink-2 dot between them, both in ink (the muted ink falls
     to 4:1 on the glass over the darkest strokes), the current one with the link's underline. 44 x 44
     targets. */
  .langs {
    position: relative;
    display: flex;
  }
  .langs::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    border-radius: 50%;
    background: var(--ink-2);
  }
  .langs a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    font: 400 var(--fs-small) / 1 var(--sans);
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 0.22em;
    outline-offset: -3px;
    transition: background-color var(--t-hover) ease;
  }
  .langs a[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-thickness: 0.07em;
  }
  /* The action: the green pill at the far end, the same height as the glass. Flat like every button: its
     fill is opaque, so it needs no lift (T23). */
  .top__cta {
    flex: none;
    margin-left: auto;
    min-height: 44px;
    padding: 0 18px;
    font-size: var(--fs-small);
    white-space: nowrap;
    pointer-events: auto;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover,
    .langs a:not([aria-current]):hover {
      background: rgb(255 255 255 / 0.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site,
    .nav__chip {
      transition: none;
    }
    .site[data-hidden] {
      transform: none;
    }
  }

  /* Below the desktop the name a step smaller, the button without its mark. */
  @media (max-width: 1100px) {
    .wordmark {
      font-size: var(--fs-body);
    }
    .top__cta :global(.btn__mark) {
      display: none;
    }
  }
  /* Just above the phones the name, the four links, ES · EN and the button need about 700 px in Spanish
     (Georgia and Albert Sans advances): the links and the switch tighten, and from 820 px down the name
     gives way to the monogram (below), so all of it fits beside a desktop scrollbar from 721 px. */
  @media (max-width: 860px) {
    nav a {
      padding-inline: 10px;
    }
    .langs a {
      min-width: 40px;
    }
    .top__cta {
      padding-inline: 12px;
    }
  }
  /* Phones: the links hide; the name, the ES · EN pill and the action stay on one line down to 390 px. */
  @media (max-width: 720px) {
    .top {
      min-height: 56px;
      gap: 6px;
    }
    nav {
      display: none;
    }
    .wordmark {
      padding-inline: 10px;
    }
    .top__nav {
      margin-left: auto;
      padding-inline: 0;
    }
    .top__cta {
      margin-left: 0;
      padding-inline: 10px;
    }
  }
  /* Too narrow for the full name: the serif monogram, as in the footer, and the name stays in the link for
     assistive tech. On phones the bar needs about 375 px for the name (107 px in Georgia), ES · EN and the
     longer button ("Contactame"), so from 390 px it fits with 15 px to spare for a wider fallback serif;
     between 721 and 820 px the four links take the room. */
  @media (max-width: 389px), (min-width: 721px) and (max-width: 820px) {
    .wordmark__full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .wordmark__mono {
      display: inline;
      font-size: var(--fs-sub);
      letter-spacing: -0.02em;
    }
  }
</style>
