---
import "../styles/global.css";
import { languages, t, type Lang } from "../i18n/ui";
import { home } from "../i18n/home";
import Footer from "../components/Footer.astro";
import BtnMark from "../components/BtnMark.astro";
// The sans's regular weight, the first text painted; the same file global.css's @font-face points at.
import sansRegular from "@fontsource/albert-sans/files/albert-sans-latin-400-normal.woff2?url";

interface Props {
  lang: Lang;
  /** Path after each language prefix, e.g. { es: "casos/automatizacion/", en: "cases/automation/" };
   *  the home page by default. The ES | EN switch, canonical and hreflang follow it. */
  paths?: Record<Lang, string>;
  /** The page's own title and description; the site's by default. */
  title?: string;
  description?: string;
}

const { lang, paths = { es: "", en: "" }, title = t(lang, "site.title"), description = t(lang, "site.description") } = Astro.props;
const href = (l: Lang) => `/${l}/${paths[l]}`;
const isHome = !paths[lang];
// The home's section anchors: from another page they lead back to the home, except the page's own
// contact call and the top of the page.
const at = (anchor: string) => (isHome || !anchor.startsWith("#") || anchor === "#top" || anchor === "#contact" ? anchor : `/${lang}/${anchor}`);
const copy = home[lang];
const footer = {
  ...copy.footer,
  columns: copy.footer.columns.map((column) => ({ ...column, links: column.links.map((link) => ({ ...link, href: at(link.href) })) })),
};
// Caps the display size so the longer hero line always fits the text column (the viewport less both
// insets and the 12 px a cable station may push the heading in). The serif averages ~0.48em per
// character in Georgia (measured on the hero lines); 0.5 leaves room for wider fallback serifs.
const fit = `calc((100vw - 2 * var(--inset) - 12px) / ${(Math.max(copy.hero.line1.length, copy.hero.line2.length) * 0.5).toFixed(2)})`;
---

<!doctype html>
<html lang={lang} style={`--fit:${fit}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="preload" href={sansRegular} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(href(lang), Astro.site)} />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(href(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(href("es"), Astro.site)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#content">{copy.skip}</a>
    <!-- Sticky bar on the page's paper, continuous with the hero: stays on screen while the page scrolls. -->
    <header class="site" id="top">
      <div class="top wrap">
        <!-- The full name on one line; on the narrowest phones the serif monogram stands in for it on
             screen, and the name stays the link's accessible name. -->
        <a class="wordmark" href={`/${lang}/`}><span class="wordmark__full">Lautaro Guebel</span><span class="wordmark__mono" aria-hidden="true">LG</span></a>
        <nav aria-label={copy.nav.label}>
          <ul>
            <li><a href={at("#automation")}>{copy.nav.cases}</a></li>
            <li><a href={at("#method")}>{copy.nav.method}</a></li>
            <li><a href={at("#offer")}>{copy.nav.offer}</a></li>
            <li><a href={at("#contact")}>{copy.nav.contact}</a></li>
          </ul>
        </nav>
        <div class="top__end">
          <div class="langs" role="group" aria-label={copy.nav.language}>
            {
              (Object.keys(languages) as Lang[]).map((l) =>
                l === lang ? (
                  <a href={href(l)} aria-current="page">{l.toUpperCase()}</a>
                ) : (
                  <a href={href(l)} hreflang={l} lang={l}>
                    <span aria-hidden="true">{l.toUpperCase()}</span>
                    <span class="sr-only">{t(lang, "nav.switch")}</span>
                  </a>
                ),
              )
            }
          </div>
          <a class="btn top__cta" href="#contact">{copy.nav.cta}<BtnMark kind="arrow" /></a>
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <Footer copy={footer} />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 20;
    background: var(--ink);
    color: var(--plate);
    padding: 12px 16px;
  }
  .skip:focus {
    left: var(--inset);
  }

  .site {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    view-transition-name: site-header;
  }
  .top {
    display: flex;
    align-items: center;
    gap: var(--gutter);
    min-height: 60px;
  }
  .top__end {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* ES · EN: two words in the sans with a drawn ink-2 dot between them; the current one in ink with
     the link's underline, the other in the muted ink (6.8:1), darkening on hover. 44 x 40 targets. */
  .langs {
    position: relative;
    display: flex;
  }
  .langs::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
    border-radius: 50%;
    background: var(--ink-2);
  }
  .langs a {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 40px;
    font: 400 var(--fs-small) / 1 var(--sans);
    color: var(--ink-2);
    text-decoration: none;
    text-underline-offset: 0.22em;
    transition: color var(--t-hover) ease;
  }
  .langs a[aria-current="page"] {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-thickness: 0.07em;
  }
  .top__cta {
    min-height: 36px;
    padding: 6px 16px;
    font-size: var(--fs-small);
    white-space: nowrap;
  }
  /* The name on one line, in the serif at the subhead size; a step down on phones. Never cut: it keeps
     its width, and where it would not fit the monogram stands in (below). */
  .wordmark {
    flex: none;
    white-space: nowrap;
    font: 400 var(--fs-sub) / 1 var(--serif);
    letter-spacing: -0.01em;
    text-decoration: none;
    padding: 12px 0;
  }
  .wordmark__mono {
    display: none;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
  }
  nav a {
    display: inline-block;
    padding: 12px 0;
    font: 400 var(--fs-small) / 1.3 var(--sans);
    text-decoration: none;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 0.07em;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      text-decoration: underline;
    }
    .langs a:not([aria-current]):hover {
      color: var(--ink);
    }
  }

  /* Below the desktop the links share the bar: the name a step smaller, the button without its mark. */
  @media (max-width: 1100px) {
    .wordmark {
      font-size: var(--fs-body);
    }
    .top__cta :global(.btn__mark) {
      display: none;
    }
  }
  /* Just above the phones the name, the four links, ES · EN and the button need about 640 px in Spanish:
     the bar's gaps tighten so they fit beside a desktop scrollbar from 721 px. */
  @media (max-width: 860px) {
    .top,
    nav ul {
      gap: 12px;
    }
  }
  @media (max-width: 720px) {
    .top {
      min-height: 56px;
    }
    nav {
      display: none;
    }
    .top__end {
      margin-left: auto;
    }
    /* Name, ES · EN and the button on one line down to 390 px: the gaps and the button's sides tighter. */
    .top {
      gap: 12px;
    }
    .top__end {
      gap: 8px;
    }
    .top__cta {
      padding-inline: 12px;
    }
  }
  /* Too narrow for the full name beside the switch and the button: the serif monogram, as in the
     footer. The name stays in the link for assistive tech. The bar needs about 375 px for the name (107
     px in Georgia), ES · EN and the longer button ("Contactame"); from 390 px it fits with 15 px to
     spare for a wider fallback serif. */
  @media (max-width: 389px) {
    .wordmark__full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .wordmark__mono {
      display: inline;
      font-size: var(--fs-sub);
      letter-spacing: -0.02em;
    }
  }
</style>
