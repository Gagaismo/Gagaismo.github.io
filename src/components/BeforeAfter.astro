---
import type { HomeCopy } from "../i18n/home";
import { Image } from "astro:assets";
import ImageSlot from "./ImageSlot.astro";
import PhoneFrame from "./PhoneFrame.astro";
import Words from "./Words.astro";
import antes from "../assets/images/before-desk.jpg";
import afterScreen from "../assets/images/case/after-screen.png";

interface Props {
  copy: HomeCopy["change"];
  /** The case's own page (T4). */
  caseLink?: { href: string; label: string };
}

const { copy, caseLink } = Astro.props;
// The generated, illustrative "Alta de alumno" screen (L55), in the drawn phone.
const screens = [afterScreen];
---

<section class="compare" id="automation" data-case="automation" aria-labelledby="change-title">
  <div class="wrap grid compare__head">
    <h2 id="change-title" class="head" data-reveal="words"><Words text={copy.title} /></h2>
    <div class="compare__intro">
      <p class="lead">{copy.intro}</p>
    </div>
  </div>
  <div class="compare__pair">
    <div class="side side--before">
      <h3 class="specimen">{copy.before.title}</h3>
      <div class="plate side__plate">
        <ImageSlot
          name="before-desk"
          src={antes}
          alt={copy.before.imageAlt}
          ratio="4 / 3"
          sizes="(max-width: 720px) 100vw, 50vw"
          widths={[480, 720, 1080]}
        />
      </div>
      <ul class="side__list">
        {copy.before.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="side side--after">
      <h3 class="specimen">{copy.after.title}</h3>
      <ImageSlot name="student-screens" ratio="4 / 3">
        <div class="phones">
          {
            screens.map((src, i) => (
              <PhoneFrame data-reveal style={`--i:${i + 1}`}>
                <Image src={src} alt={copy.screens.alts[i]!} widths={[240, 480, 720]} sizes="(max-width: 720px) 51vw, 200px" />
              </PhoneFrame>
            ))
          }
        </div>
        {copy.screens.caption && <p class="caption phones__caption">{copy.screens.caption}</p>}
      </ImageSlot>
      <ul class="side__list">
        {copy.after.items.map((item) => <li>{item}</li>)}
      </ul>
      <!-- The case link closes the new way, so it never sits above a heading as a kicker (T18). -->
      {caseLink && <a class="link compare__case" href={caseLink.href}>{caseLink.label}</a>}
    </div>
  </div>
</section>

<style>
  .compare__head {
    align-items: end;
    row-gap: 20px;
    padding-block: var(--gap-section) clamp(2rem, 4vw, 3.5rem);
  }
  .compare__head h2 {
    grid-column: 1 / span 6;
  }
  .compare__intro {
    grid-column: 7 / -1;
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .compare__head p {
    max-width: 44ch;
  }
  .compare__case {
    justify-self: start;
    font-weight: 600;
    white-space: nowrap;
    padding-block: 6px;
  }
  .compare__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(2rem, 4vw, 3.5rem) var(--inset) clamp(2.5rem, 5vw, 4.5rem);
  }
  /* Before: the page's own paper, the old way in the muted ink. After: the case's sage wash, a step in
     tone, so the change reads at once. */
  /* The inner edges take the margin, not the inset: past --page-max the inset grows and squeezed both
     columns to a third of their width (T23). */
  .side--before {
    padding-right: calc(var(--gutter) / 2 + var(--margin));
  }
  .side--after {
    background: var(--sage);
    padding-left: calc(var(--gutter) / 2 + var(--margin));
  }
  /* The two words at the hero's size, in the sans at its regular weight, tracked in. */
  .specimen {
    font: 400 var(--fs-display) / 0.9 var(--sans);
    letter-spacing: -0.03em;
  }
  .side--before .specimen {
    color: var(--ink-2);
  }

  /* The desk photo sits on the brighter paper, toned down a little so it matches the page. */
  .side__plate {
    padding: clamp(0.625rem, 1.4vw, 1rem);
  }
  .side__plate :global(img) {
    filter: sepia(0.2) saturate(0.82);
  }

  /* The lists carry no boxes: a filled mark in front of each line, a dash for the old way and a sage
     dot for the new one, each centred on the middle of the line's first row. */
  .side__list {
    display: grid;
    gap: 12px;
  }
  .side__list li {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    column-gap: 14px;
    max-width: 52ch;
    line-height: 1.5;
  }
  .side__list li::before {
    content: "";
    align-self: start;
    margin-top: calc(0.75em - 1px);
    height: 2px;
    background: var(--ink-2);
  }
  .side--after .side__list li::before {
    width: 9px;
    height: 9px;
    margin-top: calc(0.75em - 4.5px);
    border-radius: 50%;
    background: var(--sage-ink);
  }

  /* The generated screen in the drawn phone, on a sheet of mica over the sage wash. The phone's size
     comes from its width and the sheet grows to hold it and the caption: taken from the 4:3 slot's
     height, it shrank to 55 px wide with two columns (T23). */
  .side--after :global(.slot) {
    aspect-ratio: auto;
    display: grid;
    grid-template-rows: auto auto;
    justify-items: center;
    align-content: center;
    gap: 4px;
    padding: clamp(1rem, 2.4vw, 1.75rem);
    background: var(--mica);
    border-radius: var(--radius-panel);
    box-shadow: var(--glass-rim);
    backdrop-filter: var(--glass-blur);
  }
  /* Safari before 18 (see .plate in global.css). */
  @supports (-webkit-backdrop-filter: none) {
    .side--after :global(.slot) {
      -webkit-backdrop-filter: var(--glass-blur);
    }
  }
  .phones {
    display: flex;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }
  /* The frame's children are absolute, so it needs an explicit width; 180 px at 721 fits the narrowest
     sheet (235 px inside). */
  .phones :global(.phone) {
    flex: none;
    width: clamp(180px, 15vw, 220px);
    height: auto;
  }
  /* The screen image carries its own status bar, so it fills the cut-out edge to edge. */
  .phones :global(.phone__screen img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .phones__caption {
    text-align: center;
  }

  @media (max-width: 900px) {
    .compare__head h2,
    .compare__intro {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .compare__pair {
      grid-template-columns: 1fr;
    }
    .side--before,
    .side--after {
      padding-inline: var(--inset);
    }
    .phones :global(.phone) {
      width: min(210px, 56vw);
    }
  }
</style>
