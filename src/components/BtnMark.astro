---
// The drawn mark after a button's label (S11): an envelope for the actions that write an email, an
// arrow for the ones that lead down the page. The page's 1.5px line in the label's colour; styled in
// src/styles/global.css with the buttons.
interface Props {
  kind: "mail" | "arrow";
}

const { kind } = Astro.props;
---

{
  kind === "mail" ? (
    <svg class="btn__mark" viewBox="0 0 18 13" width="18" height="13" aria-hidden="true" focusable="false">
      <rect x="0.75" y="0.75" width="16.5" height="11.5" />
      <path d="M1.5 1.5 L9 7.25 L16.5 1.5" />
    </svg>
  ) : (
    <svg class="btn__mark" viewBox="0 0 18 13" width="18" height="13" aria-hidden="true" focusable="false">
      <path d="M1 6.5 H16 M11 1.5 L16 6.5 L11 11.5" />
    </svg>
  )
}
