---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

// One picture slot. With `src` it renders a responsive AVIF/WebP picture; without it, the slot's
// drawn fallback (default slot) or a plain decorative colour field. Swapping a generated image in
// later is one prop: <ImageSlot name="portrait" src={portrait} alt="..." ... />.
interface Props {
  name: string;
  src?: ImageMetadata;
  alt?: string;
  /** CSS aspect-ratio of the frame, e.g. "21 / 9". */
  ratio: string;
  /** The ground under a drawn slot: a paper tone, or a case's wash. */
  tone?: "tone" | "plate" | "sage" | "straw";
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** CSS object-position for the crop. */
  position?: string;
  class?: string;
}

const {
  name,
  src,
  alt = "",
  ratio,
  tone = "tone",
  sizes = "100vw",
  widths = [480, 800, 1200, 1600],
  eager = false,
  position = "50% 50%",
  class: className,
} = Astro.props;
const drawn = !src && Astro.slots.has("default");
// Never upscale: keep the widths below the source and add the source width itself.
const usable = src ? [...widths.filter((w) => w < src.width), src.width] : [];
---

<figure
  class:list={["slot", `slot--${tone}`, className]}
  data-slot={name}
  data-shutter={src ? "" : undefined}
  aria-hidden={!src && !drawn ? "true" : undefined}
  style={`--ratio:${ratio};--pos:${position}`}
>
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        formats={["avif", "webp"]}
        widths={usable}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    ) : (
      drawn && <slot />
    )
  }
</figure>

<style>
  .slot {
    aspect-ratio: var(--ratio);
    overflow: clip;
    background: var(--tone);
  }
  .slot--plate {
    background: var(--plate);
  }
  .slot--sage {
    background: var(--sage);
  }
  .slot--straw {
    background: var(--straw);
  }
  .slot :global(picture),
  .slot :global(img) {
    width: 100%;
    height: 100%;
  }
  .slot :global(img) {
    object-fit: cover;
    object-position: var(--pos);
  }
</style>
