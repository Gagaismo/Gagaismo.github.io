---
import type { HomeCopy } from "../i18n/home";
import ImageSlot from "./ImageSlot.astro";
import Words from "./Words.astro";
import cancha from "../assets/images/padel-court.jpg";

interface Props {
  copy: HomeCopy["padel"];
  /** The case's own page (T4). */
  caseLink?: { href: string; label: string };
}

// The second estate of the atlas (L75): the club on the straw wash. Its system is drawn as a plan, one
// plot per part of the club, so the engineering reads as content; the court photo sits on a plate.
const { copy, caseLink } = Astro.props;
const lists = [
  { title: copy.problemTitle, items: copy.problems },
  { title: copy.builtTitle, items: copy.built },
];
const ink = "#1f2a22";
const plate = "#fbf6e6";
---

<section class="padel sec-pad" id="padel" data-case="padel" aria-labelledby="padel-title">
  <div class="wrap grid padel__grid">
    <div class="padel__intro">
      <h2 id="padel-title" class="head" data-reveal="words"><Words text={copy.title} /></h2>
      <p class="lead">{copy.lead}</p>
      {caseLink && <a class="link padel__case" href={caseLink.href}>{caseLink.label}</a>}
    </div>

    <!-- The court photo is the case's picture: on the plate paper beside the text, toned to the page. -->
    <div class="plate padel__visual">
      <ImageSlot
        name="club-court"
        src={cancha}
        alt={copy.imageAlt}
        ratio="auto"
        position="50% 60%"
        sizes="(max-width: 900px) 100vw, 40vw"
        widths={[640, 1024, 1440]}
        class="padel__photo"
      />
    </div>

    <!-- The plan of the system: plots of different sizes, the paths between them in the plate's paper. -->
    <figure class="plate padel__plan" data-plan>
      <h3 class="plan__title">{copy.plan.title}</h3>
      <svg class="plan__compass" data-compass viewBox="-26 -36 52 66" aria-hidden="true" focusable="false">
        <circle r="16" fill="none" stroke={ink} stroke-width="1" />
        <path d="M-22 0L0 -3L22 0L0 3Z" fill={plate} stroke={ink} stroke-width="1" />
        <path d="M0 -24L4.5 0L0 24L-4.5 0Z" fill={plate} stroke={ink} stroke-width="1" />
        <path d="M0 -24L4.5 0H-4.5Z" fill={ink} />
        <text class="plan__north" y="-28" text-anchor="middle" font-size="11" fill={ink}>N</text>
      </svg>
      <ul class="plots">
        {
          copy.plan.plots.map((plot, i) => (
            <li class:list={["plot", `plot--${i}`]} data-plot>
              <p class="plot__name">{plot.title}</p>
              <p class="plot__text">{plot.text}</p>
            </li>
          ))
        }
      </ul>
      <figcaption class="caption">{copy.plan.caption}</figcaption>
    </figure>

    <div class="padel__lists">
      {
        lists.map((list) => (
          <div class="facts">
            <h3 class="facts__title">{list.title}</h3>
            <ul>
              {list.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <!-- How it ended, as a register: survey stations on one ink line, each with when it happened (the
           demo's real date, then "the same day") and what. -->
      <div class="facts facts--register">
        <h3 class="facts__title">{copy.outcomeTitle}</h3>
        <ol class="register">
          {
            copy.outcomes.map((o) => (
              <li>
                {o.date ? <time class="register__when" datetime={o.date}>{o.when}</time> : <span class="register__when">{o.when}</span>}
                <span>{o.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .padel__grid {
    row-gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }
  .padel__intro {
    grid-column: 1 / span 6;
    grid-row: 1;
    display: grid;
    gap: 18px;
  }
  .padel__intro .lead {
    max-width: 40ch;
  }
  .padel__case {
    justify-self: start;
    font-weight: 600;
    padding-block: 6px;
  }

  /* The photo fills the column as tall as the intro and the plan beside it. */
  .padel__visual {
    --pad: clamp(0.625rem, 1.4vw, 1rem);
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
    align-self: stretch;
    position: relative;
    min-height: 320px;
    padding: var(--pad);
  }
  .padel__visual :global(.padel__photo) {
    position: absolute;
    inset: var(--pad);
  }
  .padel__visual :global(img) {
    filter: sepia(0.3) saturate(0.75);
  }

  .padel__plan {
    grid-column: 1 / span 7;
    grid-row: 2;
    position: relative;
  }
  /* The title's row is as tall as the compass beside it, so the plots start 14 px under the rose and
     never run under it (L113, impeccable live canvas). */
  .plan__title {
    font: 600 var(--fs-lead) / 1.25 var(--sans);
    letter-spacing: -0.01em;
    min-height: 52px;
    padding-right: 56px;
    margin-bottom: 14px;
  }
  .plan__compass {
    position: absolute;
    top: var(--plate-pad);
    right: var(--plate-pad);
    width: 40px;
    height: auto;
    overflow: visible;
  }
  .plan__north {
    font-family: var(--sans);
    font-weight: 600;
  }
  /* Plots of different sizes, like a cadastral sheet: the roles run across the whole estate, the other
     parts share the rows unevenly. The gaps are the paths, in the plate's paper. */
  .plots {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
  }
  .plot {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 14px 16px 16px;
    border-radius: var(--radius-control);
    background: var(--straw);
  }
  .plot--0 {
    grid-column: span 6;
    background: var(--tone);
  }
  .plot--1,
  .plot--4 {
    grid-column: span 2;
  }
  .plot--2,
  .plot--3 {
    grid-column: span 4;
  }
  .plot--2 {
    background: var(--paper);
  }
  .plot__name {
    font: 600 var(--fs-lead) / 1.2 var(--sans);
    letter-spacing: -0.01em;
  }
  .plot__text {
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  /* What the case was and what was built: lists with an ochre dash per line, no boxes, the dash level
     with the middle of the line's first letters. How it ended: a register, below. */
  .padel__lists {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter) calc(var(--gutter) * 2);
    align-items: start;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }
  .facts__title {
    font: 600 var(--fs-lead) / 1.25 var(--sans);
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }
  .facts ul {
    display: grid;
    gap: 12px;
  }
  /* The dash column belongs to the lists only: the register below draws its own stations. */
  .facts ul li {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    column-gap: 14px;
    max-width: 44ch;
    line-height: 1.5;
  }
  .facts ul li::before {
    content: "";
    align-self: start;
    margin-top: calc(0.75em - 1px);
    height: 2px;
    background: var(--ochre);
  }

  /* The register: an ink line down the side with a station per entry (an ink ring on the plate paper,
     like the contract's days on the case page), the when as a title, the what under it; beside it
     where the column is wide enough, every when in one column so the whats start on one line. */
  .facts--register {
    container-type: inline-size;
  }
  .register {
    display: grid;
    gap: 18px;
  }
  /* The line runs from each station to the next one, so it starts and stops on a station. */
  .register li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 7px;
    top: calc(0.2em + 15px);
    bottom: calc(-18px - 0.2em);
    width: var(--line);
    background: var(--ink);
  }
  .register li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    padding-left: 30px;
    max-width: 44ch;
    line-height: 1.5;
  }
  .register li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--plate);
    box-shadow: inset 0 0 0 var(--line-bold) var(--ink);
  }
  .register__when {
    font: 600 var(--fs-lead) / 1.25 var(--sans);
    font-variant-numeric: tabular-nums;
  }
  @container (min-width: 22rem) {
    .register {
      grid-template-columns: max-content minmax(0, 1fr);
      max-width: 56ch;
    }
    .register li {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      gap: 0 16px;
      align-items: baseline;
      max-width: none;
    }
  }

  @media (max-width: 900px) {
    .padel__intro,
    .padel__visual,
    .padel__plan,
    .padel__lists {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .padel__visual {
      min-height: 0;
      aspect-ratio: 3 / 2;
    }
  }
  @media (max-width: 720px) {
    .padel__lists {
      grid-template-columns: 1fr;
    }
    .plots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Still plots of different sizes: two share a row, the last two run across, never four equal boxes. */
    .plot--0,
    .plot--3,
    .plot--4 {
      grid-column: span 2;
    }
    .plot--1,
    .plot--2 {
      grid-column: span 1;
    }
    .plot {
      padding: 12px;
    }
  }
</style>
