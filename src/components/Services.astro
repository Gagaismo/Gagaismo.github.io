---
import type { HomeCopy } from "../i18n/home";
import ImageSlot from "./ImageSlot.astro";
import owner from "../assets/images/business-owner.jpg";

interface Props {
  copy: HomeCopy["offer"];
}

// What can be built for a small business, told as what the owner gains (L40: no tool names). Set as a
// ledger on the plate paper: one entry per thing, the old way struck through in brick ink above it, so an
// owner spots their own problem at a glance.
const { copy } = Astro.props;
---

<section class="offer sec-pad" id="offer" aria-labelledby="offer-title">
  <div class="wrap">
    <div class="grid offer__head">
      <h2 class="head" id="offer-title" data-reveal>{copy.title}</h2>
      <p>{copy.intro}</p>
      <div class="plate offer__plate">
        <ImageSlot
          name="business-owner"
          src={owner}
          alt={copy.imageAlt}
          ratio="16 / 9"
          position="50% 40%"
          sizes="(max-width: 720px) 100vw, 40vw"
          widths={[640, 960, 1440]}
        />
      </div>
    </div>
    <ul class="ledger plate">
      {
        copy.items.map((item) => (
          <li class="entry" data-benefit>
            <h3 class="entry__title">{item.title}</h3>
            <p class="entry__was">
              <span class="sr-only">{copy.wasLabel}</span>
              <s>{item.was}</s>
            </p>
            <p class="entry__text" data-benefit-text>{item.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="lead offer__close">{copy.close}</p>
  </div>
</section>

<style>
  .offer.sec-pad {
    padding-bottom: 0;
  }
  .offer__head {
    grid-template-rows: auto 1fr;
    row-gap: 18px;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .offer__head h2 {
    grid-column: 1 / span 7;
  }
  .offer__head p {
    grid-column: 1 / span 6;
    max-width: 52ch;
  }
  .offer__plate {
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
    align-self: start;
    padding: clamp(0.625rem, 1.4vw, 1rem);
  }
  .offer__plate :global(img) {
    filter: sepia(0.2) saturate(0.82);
  }

  /* The ledger: one plate, one entry per thing, the entries apart by space alone. Two columns: on the
     left the old way, struck through in small serif italic, over the new way's title; on the right its
     sentence, level with the title. The title comes first in the markup, so assistive tech reads it
     first; on phones the three stack in the visual order. */
  .ledger {
    display: grid;
    row-gap: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.25rem, 2.6vw, 2rem) var(--plate-pad);
  }
  .entry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 4px;
    align-items: baseline;
  }
  .entry__title {
    grid-column: 1 / span 6;
    grid-row: 2;
    font: 400 var(--fs-sub) / 1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .entry__was {
    grid-column: 1 / span 6;
    grid-row: 1;
    font: 400 var(--fs-small) / 1.4 var(--serif);
    font-style: italic;
    color: var(--ink-2);
  }
  .entry__was s {
    text-decoration-color: var(--brick);
    text-decoration-thickness: 0.1em;
  }
  .entry__text {
    grid-column: 7 / -1;
    grid-row: 2;
    max-width: 52ch;
  }
  /* The contact follows right below, so the offer closes on this sentence, no button. */
  .offer__close {
    padding-top: clamp(2rem, 4vw, 3rem);
    max-width: 38ch;
  }

  @media (max-width: 900px) {
    .offer__head h2,
    .offer__head p,
    .offer__plate {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .offer__plate :global(.slot) {
      aspect-ratio: 5 / 2;
    }
  }
  @media (max-width: 720px) {
    .entry__title,
    .entry__was,
    .entry__text {
      grid-column: 1 / -1;
    }
    .entry__text {
      grid-row: 3;
      margin-top: 4px;
    }
  }
</style>
