---
// The academy's process drawn as a survey plan: the sale on top creates the student, the student gets
// access, signs the contract and pays the instalments; the failure path to the operator dashed in brick.
// Drawn on a 360-wide sheet so its labels stay readable on a phone.
interface Props {
  label: string;
  nodes: [string, string, string, string, string, string];
  links: [string, string, string, string, string];
}

const { label, nodes, links } = Astro.props;
const [sale, student, access, contract, instalments, operator] = nodes;
const [creates, gets, signs, pays, alerts] = links;
const W = 108;
const H = 44;
// Top-left corner of each box.
const box = {
  sale: [126, 4],
  student: [126, 120],
  operator: [4, 120],
  access: [4, 240],
  contract: [126, 240],
  instalments: [248, 240],
} as const;
const cx = (k: keyof typeof box) => box[k][0] + W / 2;
const cy = (k: keyof typeof box) => box[k][1] + H / 2;
const fill: Record<keyof typeof box, string> = {
  sale: "#ebdcae",
  student: "#ebdcae",
  operator: "#fbf6e6",
  access: "#dce3d0",
  contract: "#dce3d0",
  instalments: "#dce3d0",
};
const names: Record<keyof typeof box, string> = { sale, student, operator, access, contract, instalments };
const ink = "#1f2a22";
const brick = "#9c4127";
---

<svg class="pmap" viewBox="0 0 360 288" role="img" aria-label={label}>
  <defs>
    <marker id="pmap-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L10 5 L0 10 z" fill={ink}></path>
    </marker>
    <marker id="pmap-brick" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 L10 5 L0 10 z" fill={brick}></path>
    </marker>
  </defs>
  <g fill="none" stroke={ink} stroke-width="1.5" marker-end="url(#pmap-ink)">
    <path d={`M${cx("sale")} ${box.sale[1] + H} V${box.student[1] - 2}`}></path>
    <path d={`M${box.student[0] + 18} ${box.student[1] + H} L${cx("access")} ${box.access[1] - 2}`}></path>
    <path d={`M${cx("student")} ${box.student[1] + H} V${box.contract[1] - 2}`}></path>
    <path d={`M${box.student[0] + W - 18} ${box.student[1] + H} L${cx("instalments")} ${box.instalments[1] - 2}`}></path>
  </g>
  <path
    d={`M${box.sale[0]} ${cy("sale")} H${cx("operator")} V${box.operator[1] - 2}`}
    fill="none"
    stroke={brick}
    stroke-width="1.5"
    stroke-dasharray="6 5"
    marker-end="url(#pmap-brick)"></path>
  <g class="pmap__links">
    <text x={cx("sale") + 8} y="90">{creates}</text>
    <text x="64" y="206" text-anchor="end">{gets}</text>
    <text x={cx("contract") + 8} y="210">{signs}</text>
    <text x="300" y="206">{pays}</text>
    <text x={cx("operator") + 8} y="84" class="pmap__fail">{alerts}</text>
  </g>
  {
    (Object.keys(box) as (keyof typeof box)[]).map((k) => (
      <g>
        <rect x={box[k][0]} y={box[k][1]} width={W} height={H} fill={fill[k]} stroke={k === "operator" ? brick : ink} stroke-width="1.25" />
        <text x={cx(k)} y={cy(k) + 5} text-anchor="middle" class="pmap__node">
          {names[k]}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .pmap {
    width: 100%;
    max-width: 460px;
    height: auto;
  }
  .pmap__node {
    font: 600 15px var(--sans);
    fill: var(--ink);
  }
  .pmap__links {
    font: italic 400 14px var(--serif);
    fill: var(--ink-2);
  }
  .pmap__links .pmap__fail {
    fill: var(--brick);
  }
</style>
