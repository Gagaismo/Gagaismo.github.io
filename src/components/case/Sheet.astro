---
// A drawn sheet of the case: the artifact itself on the brighter paper (or a wash), its title on top
// and an italic caption under it, as in an atlas.
interface Props {
  title: string;
  caption: string;
  tone?: "plate" | "sage" | "straw";
  class?: string;
}

const { title, caption, tone = "plate", class: className } = Astro.props;
---

<figure class:list={["sheet", className]}>
  <div class:list={["plate", tone !== "plate" && `plate--${tone}`, "sheet__body"]}>
    <h3 class="sheet__title">{title}</h3>
    <slot />
  </div>
  <figcaption class="caption">{caption}</figcaption>
</figure>

<style>
  .sheet__body {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .sheet__title {
    font: 400 var(--fs-lead) / 1.25 var(--serif);
  }
</style>
