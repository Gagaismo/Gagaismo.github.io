---
import type { HomeCopy } from "../i18n/home";
import { email, mailto } from "../i18n/home";
import BtnMark from "./BtnMark.astro";

interface Props {
  copy: HomeCopy["contact"];
}

const { copy } = Astro.props;
const first = copy.drafts[0]!;
---

<section class="contact sec-pad" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="grid contact__head">
      <h2 class="head" id="contact-title" data-reveal>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>

    <div class="grid composer">
      <fieldset class="pick">
        <legend>{copy.pickTitle}</legend>
        {
          copy.drafts.map((d, i) => (
            <label class="opt">
              <input
                type="radio"
                name="topic"
                value={d.value}
                checked={i === 0}
                data-draft={d.text}
                data-mailto={mailto(copy.subject, d.text)}
              />
              {d.label}
            </label>
          ))
        }
      </fieldset>
      <div class="draft">
        <p class="draft__label" id="draft-label">{copy.draftLabel}</p>
        <p class="draft__text" id="draft" aria-labelledby="draft-label" aria-live="polite">{first.text}</p>
        <div class="draft__actions">
          <a class="btn" id="send" href={mailto(copy.subject, first.text)}>{copy.send}<BtnMark kind="mail" /></a>
          <button type="button" class="btn btn--quiet" id="copy" data-ok={copy.copied} data-fail={copy.copyFailed}>
            {copy.copy}
          </button>
          <span class="draft__status" id="copy-status" role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </div>

  <ul class="rows wrap">
    <li class="row">
      <a class="display" href={`mailto:${email}`}>{email}</a><small>{copy.emailNote}</small>
    </li>
    <li class="row">
      <span class="display">{copy.place}</span><small>{copy.placeNote}</small>
    </li>
  </ul>
</section>

<style>
  .contact.sec-pad {
    padding-bottom: 0;
  }
  /* Heading over the topics, intro over the draft: the two columns the composer uses below. */
  .contact__head {
    align-items: end;
    row-gap: 20px;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .contact__head h2 {
    grid-column: 1 / span 6;
  }
  .contact__head p {
    grid-column: 7 / -1;
    max-width: 70ch;
  }
  .composer {
    align-items: stretch;
    row-gap: 24px;
  }
  .pick {
    grid-column: 1 / span 5;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .pick legend {
    font-size: var(--fs-lead);
    line-height: 1.25;
    font-weight: 600;
    margin-bottom: 14px;
    padding: 0;
  }
  /* Each topic a line on the brighter paper; the chosen one takes the case's sage wash. */
  .opt {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 10px 16px;
    background: var(--plate);
    margin-bottom: 8px;
    cursor: pointer;
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease,
      transform var(--t-press) var(--ease-out);
  }
  .opt:active {
    transform: scale(0.985);
  }
  /* The radio drawn as a survey station: a 1.5px ink ring on the paper; chosen, a sage band around an
     ink dot, like the cable's stations. The whole line takes the keyboard outline. */
  .opt input {
    appearance: none;
    width: 14px;
    height: 14px;
    margin: 0;
    flex: none;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    cursor: pointer;
  }
  .opt input:checked {
    background: var(--ink);
    box-shadow: inset 0 0 0 2.5px var(--sage);
  }
  .opt input:focus-visible {
    outline: none;
  }
  .opt:has(input:checked) {
    background: var(--sage);
  }
  .opt:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  @media (forced-colors: active) {
    .opt input {
      border-color: CanvasText;
    }
    .opt input:checked {
      background: CanvasText;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .opt:hover:not(:has(input:checked)) {
      background: var(--tone);
    }
  }
  .draft {
    grid-column: 7 / -1;
    display: grid;
    align-content: start;
    gap: 16px;
  }
  .draft__label {
    font-size: var(--fs-lead);
    line-height: 1.25;
    font-weight: 600;
  }
  .draft__text {
    background: var(--surface);
    padding: 22px 24px;
    line-height: 1.55;
    min-height: 9.5em;
  }
  .draft__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .draft__status {
    font-size: var(--fs-small);
    min-height: 1.5em;
  }

  /* The close: two lines on the page's grid, each label a serif caption in the first columns and the
     address or the place beside it, at the section heading's size. No band behind them. */
  .rows {
    display: grid;
    row-gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: baseline;
  }
  .row a,
  .row span {
    grid-column: 4 / -1;
    grid-row: 1;
    font-size: var(--fs-head);
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .row a {
    transition: color var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .row a:hover {
      color: var(--green);
    }
  }
  .row small {
    grid-column: 1 / span 3;
    grid-row: 1;
    font: 400 var(--fs-small) / 1.45 var(--serif);
    font-style: italic;
    color: var(--ink-2);
  }

  @media (max-width: 1100px) {
    .pick {
      grid-column: 1 / span 6;
    }
  }
  @media (max-width: 900px) {
    /* One step down where the address would crowd the width. */
    .row a,
    .row span {
      font-size: var(--fs-sub);
    }
    .contact__head h2,
    .contact__head p,
    .pick,
    .draft {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .draft__actions .btn {
      flex: 1 1 100%;
    }
    /* The caption over its line. */
    .row a,
    .row span,
    .row small {
      grid-column: 1 / -1;
    }
    .row a,
    .row span {
      grid-row: 2;
    }
  }
</style>
