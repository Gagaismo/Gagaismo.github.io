---
import type { HomeCopy } from "../i18n/home";

interface Props {
  copy: HomeCopy["method"];
}

const { copy } = Astro.props;
const [survey, map, decision, health, review] = copy.steps;
const n = copy.map.nodes;
const l = copy.map.links;
---

<section class="method sec-pad" id="method" data-case="automation" aria-labelledby="method-title">
  <div class="wrap">
    <div class="grid method__head">
      <h2 id="method-title" class="head" data-reveal>{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>

    <!-- Five steps in a row on wide screens; below 1100 px a sideways scroll that snaps to each step, with
         the next one peeking in and fading into the paper. No script: the browser scrolls it with touch,
         wheel or the arrow keys. -->
    <div class="steps" data-steps role="region" aria-label={copy.label} tabindex="0">
      <ol class="stairs">
        <li class="stage" style="--s:1">
          <h3 class="stage__line"><span class="when">{survey!.when}</span> {survey!.line}</h3>
          <p class="stage__text">{survey!.text}</p>
          <figure class="stage__art">
            <div class="plate art">
              <h4 class="art__title">{copy.survey.title}</h4>
              <dl class="survey">
                {
                  copy.survey.rows.map((row) => (
                    <div>
                      <dt>{row.task}</dt>
                      <dd>{row.how}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
            <figcaption class="caption">{survey!.caption}</figcaption>
          </figure>
        </li>

        <li class="stage" style="--s:2">
          <h3 class="stage__line"><span class="when">{map!.when}</span> {map!.line}</h3>
          <p class="stage__text">{map!.text}</p>
          <figure class="stage__art">
            <div class="plate art">
              <h4 class="art__title">{copy.map.title}</h4>
              <svg class="map" viewBox="0 0 260 248" role="img" aria-label={copy.map.label}>
                <defs>
                  <marker id="map-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                    <path d="M0 0 L10 5 L0 10 z" fill="#1f2a22" />
                  </marker>
                </defs>
                <g stroke="#1f2a22" stroke-width="1.5" fill="none" marker-end="url(#map-arrow)">
                  <path d="M52 43 V103" /><path d="M102 106 L154 46" /><path d="M52 143 V203" /><path d="M102 124 H156" /><path d="M102 224 H156" />
                </g>
                <g stroke="#1f2a22" stroke-width="1.25">
                  <g fill="#ebdcae"><rect x="2" y="5" width="100" height="38" /><rect x="2" y="105" width="100" height="38" /></g>
                  <g fill="#dce3d0"><rect x="158" y="5" width="100" height="38" /><rect x="2" y="205" width="100" height="38" /></g>
                  <g fill="#f4f1ea"><rect x="158" y="205" width="100" height="38" /><rect x="158" y="105" width="100" height="38" /></g>
                </g>
                <g class="map__nodes" text-anchor="middle">
                  <text x="52" y="31">{n[0]}</text><text x="52" y="131">{n[1]}</text><text x="208" y="31">{n[2]}</text>
                  <text x="208" y="231">{n[3]}</text><text x="52" y="231">{n[4]}</text><text x="208" y="131">{n[5]}</text>
                </g>
                <g class="map__links">
                  <text x="60" y="78">{l[0]}</text><text x="138" y="84">{l[1]}</text><text x="60" y="178">{l[2]}</text>
                  <text x="129" y="144" text-anchor="middle">{l[3]}</text><text x="129" y="216" text-anchor="middle">{l[4]}</text>
                </g>
              </svg>
              <dl class="gloss">
                {
                  copy.map.glossary.map((item) => (
                    <div>
                      <dt>{item.title}</dt>
                      <dd>{item.text}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
            <figcaption class="caption">{map!.caption}</figcaption>
          </figure>
        </li>

        <li class="stage" style="--s:3">
          <h3 class="stage__line"><span class="when">{decision!.when}</span> {decision!.line}</h3>
          <p class="stage__text">{decision!.text}</p>
          <figure class="stage__art">
            <article class="plate plate--sage art adr">
              <p class="adr__title">{copy.decision.title}</p>
              <p>{copy.decision.context}</p>
              <p class="adr__status">{copy.decision.status}</p>
            </article>
            <figcaption class="caption">{decision!.caption}</figcaption>
          </figure>
        </li>

        <li class="stage" style="--s:4">
          <h3 class="stage__line"><span class="when">{health!.when}</span> {health!.line}</h3>
          <p class="stage__text">{health!.text}</p>
          <figure class="stage__art">
            <div class="plate art">
              <h4 class="art__title">{copy.health.title}</h4>
              <ul class="checks">
                {copy.health.checks.map((check) => <li>{check}</li>)}
              </ul>
            </div>
            <figcaption class="caption">{health!.caption}</figcaption>
          </figure>
        </li>

        <li class="stage" style="--s:5">
          <h3 class="stage__line"><span class="when">{review!.when}</span> {review!.line}</h3>
          <p class="stage__text">{review!.text}</p>
          <figure class="stage__art">
            <div class="plate plate--straw art">
              <h4 class="art__title">{copy.review.title}</h4>
              <ul class="checks checks--review">
                {copy.review.states.map((state) => <li>{state}</li>)}
              </ul>
            </div>
            <figcaption class="caption">{review!.caption}</figcaption>
          </figure>
        </li>
      </ol>
    </div>
    <p class="swipe small" aria-hidden="true">
      {copy.swipe}
      <svg class="swipe__arrow" viewBox="0 0 20 12" width="20" height="12" aria-hidden="true" focusable="false">
        <path d="M1 6 H18 M13 1 L18 6 L13 11" />
      </svg>
    </p>
  </div>
</section>

<style>
  .method__head {
    align-items: end;
    row-gap: 16px;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .method__head h2 {
    grid-column: 1 / span 7;
  }
  .method__head p {
    grid-column: 8 / -1;
    max-width: 46ch;
  }
  .stairs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--gutter);
  }
  /* Each step a little lower than the one before, each proven by the sheet it leaves behind, on the
     brighter paper with its caption under it. */
  .stage {
    display: grid;
    align-content: start;
    gap: 12px;
    padding-top: calc((var(--s) - 1) * 1rem);
  }
  .stage__line {
    font-family: var(--serif);
    font-size: var(--fs-sub);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .stage__text {
    max-width: 34ch;
  }
  .stage__art {
    margin-top: 6px;
  }
  .art {
    padding: 18px;
  }
  .art__title {
    margin-bottom: 12px;
    font: 400 var(--fs-lead) / 1.25 var(--serif);
  }
  /* The sheets are read, not glanced at: their text at the body size, the notes under each line (the
     old way, in brick: 6.1:1 on the plate paper) one step down. */
  .survey {
    display: grid;
    gap: 12px;
    font-size: var(--fs-body);
    line-height: 1.3;
  }
  .survey dt {
    font-weight: 600;
  }
  .survey dd {
    margin-top: 2px;
    font-size: var(--fs-small);
    color: var(--brick);
  }
  .map {
    width: 100%;
    max-width: 320px;
    height: auto;
  }
  /* In the drawing's own units: at 1440 px (a fifth of the 80rem page, less the gutters and the plate's
     padding) the plan renders 195 px wide, at 0.75, so the labels and the links stay 13.5 px. */
  .map__nodes {
    font: 600 18px var(--sans);
    fill: var(--ink);
  }
  .map__links {
    font: italic 400 18px var(--serif);
    fill: var(--ink-2);
  }
  .gloss {
    display: grid;
    gap: 10px;
    margin-top: 14px;
    font-size: var(--fs-body);
    line-height: 1.35;
  }
  .gloss dd {
    font-size: var(--fs-small);
  }
  .gloss dt {
    font-weight: 700;
  }
  .gloss dd {
    color: var(--ink-2);
  }
  .adr {
    display: grid;
    align-content: start;
    gap: 8px;
    font-size: var(--fs-body);
    line-height: 1.4;
  }
  .adr__title {
    font: 400 var(--fs-lead) / 1.25 var(--serif);
  }
  /* The record's state, as written on it, in the deep action green (6.0:1 on the sage wash). */
  .adr__status {
    margin-top: 4px;
    font-weight: 700;
    color: var(--green-deep);
  }
  .checks {
    display: grid;
    gap: 10px;
    font-size: var(--fs-body);
    line-height: 1.3;
  }
  .checks li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .checks li::before {
    content: "";
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sage-ink);
  }
  .checks--review li::before {
    border-radius: 0;
    background: var(--ink);
  }
  .swipe {
    display: none;
    margin-top: 12px;
    color: var(--ink-2);
  }
  /* A drawn arrow in the page's 1.5px ink line, as tall as the hint's capitals. */
  .swipe__arrow {
    display: inline-block;
    width: 1.4em;
    height: 0.85em;
    margin-left: 0.4em;
    vertical-align: -0.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* Narrower screens: the row becomes a sideways scroll that snaps to each step, inside the page
     margins. One step (two from 601 px) fills the row and the next shows 18% of its width, its edge
     whole, then fades into the paper so no word is cut at the screen's edge. The last step can still
     reach the clear part: the row ends with that much room. */
  @media (max-width: 1100px) {
    .method__head h2,
    .method__head p {
      grid-column: 1 / -1;
    }
    .method .wrap {
      container-type: inline-size;
    }
    .steps {
      --show: 2;
      --card: calc((100cqw - var(--show) * var(--gutter)) / (var(--show) + 0.18));
      --peek: calc(var(--card) * 0.18);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      padding-bottom: 10px;
      scrollbar-width: thin;
      scrollbar-color: var(--sage-ink) transparent;
      /* The next card is hidden: the short soft edge falls in the gap before it, so not even a sliver
         of its letters shows; the "Deslizá" hint below says more steps follow. */
      mask-image: linear-gradient(to right, #000 calc(100% - var(--peek) - 6px), transparent calc(100% - var(--peek) - 1px));
    }
    /* Keyboard focus shows the whole row and its outline, unfaded. */
    .steps:focus-visible {
      outline-offset: -3px;
      mask-image: none;
    }
    .stairs {
      grid-auto-columns: var(--card);
      width: max-content;
      padding-inline-end: calc(var(--peek) + var(--gutter));
    }
    .stage {
      scroll-snap-align: start;
      padding-top: 0;
    }
    .swipe {
      display: block;
    }
  }
  @media (max-width: 600px) {
    .steps {
      --show: 1;
    }
  }
</style>
