---
import type { HomeCopy } from "../i18n/home";
import Words from "./Words.astro";
// Places the cards of the stack (see below); its own file, so the page's inline script stays small.
import stackScript from "../scripts/stack.js?url&no-inline";

interface Props {
  copy: HomeCopy["method"];
}

const { copy } = Astro.props;
const [survey, map, decision, health, review] = copy.steps;
const n = copy.map.nodes;
const l = copy.map.links;
---

<section class="method sec-pad" id="method" data-case="automation" aria-labelledby="method-title">
  <div class="wrap">
    <div class="grid method__head">
      <h2 id="method-title" class="head" data-reveal="words"><Words text={copy.title} /></h2>
      <p>{copy.intro}</p>
    </div>

    <!-- Five cards of mica, one per step, each with the sheet that proves it. Reading down, each card
         sticks under the header a little lower than the one before and the next slides over it, the
         covered ones sinking back (src/scripts/stack.js places them; the scale follows the scroll where
         the browser can tie it). Without the script, or with less motion asked for, a plain list. -->
    <ol class="stack" data-cards aria-label={copy.label}>
      <li class="stage plate" style="--s:1">
        <div class="stage__copy">
          <h3 class="stage__line"><span class="when">{survey!.when}</span> {survey!.line}</h3>
          <p class="stage__text">{survey!.text}</p>
        </div>
        <figure class="stage__art">
          <div class="plate art">
            <h4 class="art__title">{copy.survey.title}</h4>
            <dl class="survey">
              {
                copy.survey.rows.map((row) => (
                  <div>
                    <dt>{row.task}</dt>
                    <dd>{row.how}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          {survey!.caption && <figcaption class="caption">{survey!.caption}</figcaption>}
        </figure>
      </li>

      <li class="stage plate" style="--s:2">
        <div class="stage__copy">
          <h3 class="stage__line"><span class="when">{map!.when}</span> {map!.line}</h3>
          <p class="stage__text">{map!.text}</p>
        </div>
        <figure class="stage__art">
          <div class="plate art">
            <h4 class="art__title">{copy.map.title}</h4>
            <svg class="map" viewBox="0 0 260 248" role="img" aria-label={copy.map.label}>
              <defs>
                <marker id="map-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M0 0 L10 5 L0 10 z" fill="#1f2a22" />
                </marker>
              </defs>
              <g stroke="#1f2a22" stroke-width="1.5" fill="none" marker-end="url(#map-arrow)">
                <path d="M52 43 V103" /><path d="M102 106 L154 46" /><path d="M52 143 V203" /><path d="M102 124 H156" /><path d="M102 224 H156" />
              </g>
              <g stroke="#1f2a22" stroke-width="1.25">
                <g fill="#ebdcae"><rect x="2" y="5" width="100" height="38" /><rect x="2" y="105" width="100" height="38" /></g>
                <g fill="#dce3d0"><rect x="158" y="5" width="100" height="38" /><rect x="2" y="205" width="100" height="38" /></g>
                <g fill="#f4f1ea"><rect x="158" y="205" width="100" height="38" /><rect x="158" y="105" width="100" height="38" /></g>
              </g>
              <g class="map__nodes" text-anchor="middle">
                <text x="52" y="31">{n[0]}</text><text x="52" y="131">{n[1]}</text><text x="208" y="31">{n[2]}</text>
                <text x="208" y="231">{n[3]}</text><text x="52" y="231">{n[4]}</text><text x="208" y="131">{n[5]}</text>
              </g>
              <g class="map__links">
                <text x="60" y="78">{l[0]}</text><text x="138" y="84">{l[1]}</text><text x="60" y="178">{l[2]}</text>
                <text x="129" y="144" text-anchor="middle">{l[3]}</text><text x="129" y="216" text-anchor="middle">{l[4]}</text>
              </g>
            </svg>
            <dl class="gloss">
              {
                copy.map.glossary.map((item) => (
                  <div>
                    <dt>{item.title}</dt>
                    <dd>{item.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
          {map!.caption && <figcaption class="caption">{map!.caption}</figcaption>}
        </figure>
      </li>

      <li class="stage plate" style="--s:3">
        <div class="stage__copy">
          <h3 class="stage__line"><span class="when">{decision!.when}</span> {decision!.line}</h3>
          <p class="stage__text">{decision!.text}</p>
        </div>
        <figure class="stage__art">
          <article class="plate plate--sage art adr">
            <p class="adr__title">{copy.decision.title}</p>
            <p>{copy.decision.context}</p>
            <p class="adr__status">{copy.decision.status}</p>
          </article>
          {decision!.caption && <figcaption class="caption">{decision!.caption}</figcaption>}
        </figure>
      </li>

      <li class="stage plate" style="--s:4">
        <div class="stage__copy">
          <h3 class="stage__line"><span class="when">{health!.when}</span> {health!.line}</h3>
          <p class="stage__text">{health!.text}</p>
        </div>
        <figure class="stage__art">
          <div class="plate art">
            <h4 class="art__title">{copy.health.title}</h4>
            <ul class="checks">
              {copy.health.checks.map((check) => <li>{check}</li>)}
            </ul>
          </div>
          {health!.caption && <figcaption class="caption">{health!.caption}</figcaption>}
        </figure>
      </li>

      <li class="stage plate" style="--s:5">
        <div class="stage__copy">
          <h3 class="stage__line"><span class="when">{review!.when}</span> {review!.line}</h3>
          <p class="stage__text">{review!.text}</p>
        </div>
        <figure class="stage__art">
          <div class="plate plate--straw art">
            <h4 class="art__title">{copy.review.title}</h4>
            <ul class="checks checks--review">
              {copy.review.states.map((state) => <li>{state}</li>)}
            </ul>
          </div>
          {review!.caption && <figcaption class="caption">{review!.caption}</figcaption>}
        </figure>
      </li>
    </ol>
  </div>
  <script is:inline type="module" src={stackScript}></script>
</section>

<style>
  /* The method stands out from the paper as a band of the automation wash (L114, impeccable live
     canvas): the opaque plate cards read crisply on the sage, each with a fine ink ring. */
  .method {
    background: var(--sage);
  }
  .method__head {
    align-items: end;
    row-gap: 16px;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .method__head h2 {
    grid-column: 1 / span 7;
  }
  .method__head p {
    grid-column: 8 / -1;
    max-width: 46ch;
  }
  .stack {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  /* Each step a card of mica: what happens on the left, the sheet it leaves behind on the right (under
     it from 900 px down), on the brighter paper with its caption under it. --sink is how far the card
     sinks back once every card after it has covered it. */
  .stage {
    --sink: calc(1 - (5 - var(--s)) * 0.025);
    /* Cards cover one another: an opaque plate, or the card underneath shows through the mica. */
    background-color: var(--plate);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), 0 0 0 1px rgb(31 42 34 / 0.1);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: "copy art";
    align-items: start;
    gap: 18px calc(var(--gutter) * 2);
    padding: clamp(1.25rem, 2.6vw, 2.25rem);
  }
  .stage__copy {
    grid-area: copy;
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .stage__line {
    font: 600 var(--fs-sub) / 1.15 var(--sans);
    letter-spacing: -0.015em;
  }
  .stage__text {
    max-width: 34ch;
  }
  .stage__art {
    grid-area: art;
    justify-self: end;
    width: min(100%, 36rem);
  }
  .art {
    padding: 18px;
  }
  .art__title {
    margin-bottom: 12px;
    font: 600 var(--fs-lead) / 1.25 var(--sans);
    letter-spacing: -0.01em;
  }
  /* The sheets are read, not glanced at: their text at the body size, the notes under each line (the
     old way, in brick: 6.1:1 on the plate paper) one step down. */
  .survey {
    display: grid;
    gap: 12px;
    font-size: var(--fs-body);
    line-height: 1.3;
  }
  .survey dt {
    font-weight: 600;
  }
  .survey dd {
    margin-top: 2px;
    font-size: var(--fs-small);
    color: var(--brick);
  }
  /* Drawn at its own size at most, so the labels and the links in the drawing's units (18) render 18 px
     and no larger; on the narrowest phones the plan shrinks with its sheet. */
  .map {
    width: 100%;
    max-width: 260px;
    height: auto;
  }
  .map__nodes {
    font: 600 18px var(--sans);
    fill: var(--ink);
  }
  .map__links {
    font: italic 400 18px var(--serif);
    fill: var(--ink-2);
  }
  .gloss {
    display: grid;
    gap: 10px;
    margin-top: 14px;
    font-size: var(--fs-body);
    line-height: 1.35;
  }
  .gloss dd {
    font-size: var(--fs-small);
  }
  .gloss dt {
    font-weight: 600;
  }
  .gloss dd {
    color: var(--ink-2);
  }
  .adr {
    display: grid;
    align-content: start;
    gap: 8px;
    font-size: var(--fs-body);
    line-height: 1.4;
  }
  .adr__title {
    font: 600 var(--fs-lead) / 1.25 var(--sans);
    letter-spacing: -0.01em;
  }
  /* The record's state, as written on it, in the deep action green (6.0:1 on the sage wash). */
  .adr__status {
    margin-top: 4px;
    font-weight: 600;
    color: var(--green-deep);
  }
  .checks {
    display: grid;
    gap: 10px;
    font-size: var(--fs-body);
    line-height: 1.3;
  }
  .checks li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .checks li::before {
    content: "";
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sage-ink);
  }
  .checks--review li::before {
    border-radius: 0;
    background: var(--ink);
  }
  @media (max-width: 1100px) {
    .method__head h2,
    .method__head p {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 900px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "copy" "art";
    }
    .stage__art {
      justify-self: stretch;
      width: auto;
    }
  }

  /* The stack. Each card sticks under the header once src/scripts/stack.js has set its top (20 px lower
     than the card before, or higher for a card taller than the screen) and marked the list; until then,
     and whenever less motion is asked for, the cards are a plain list. */
  @media (prefers-reduced-motion: no-preference) {
    .stack[data-on] > .stage {
      position: sticky;
    }
  }
  /* Where the browser ties animations to the scroll, a card sinks back from its top edge while the next
     one slides over it: the list's scroll past the top of the screen is shared out evenly, a fifth per
     card. The last card is never covered. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stack[data-on] {
        view-timeline: --stack block;
      }
      .stack[data-on] > .stage {
        transform-origin: 50% 0;
        /* Longhands: the minifier folds a shorthand and its timeline into one shorthand that browsers
           reject. */
        animation-name: stage-sink;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --stack;
        animation-range: exit-crossing calc((var(--s) - 1) * 20%) exit-crossing calc(var(--s) * 20%);
      }
      .stack[data-on] > .stage:last-child {
        animation-name: none;
      }
    }
  }
  @keyframes stage-sink {
    to {
      scale: var(--sink);
    }
  }
</style>
